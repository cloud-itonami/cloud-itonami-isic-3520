{
  "viewId": "open-gas.SV-1",
  "viewType": "SV-1",
  "title": "Systems Interface Description",
  "did": "did:web:open-gas.etzhayyim.com",
  "format": "json",
  "content": {
    "systems": [
      {
        "id": "sys.worker", "name": "open-gas Worker",
        "platform": "Cloudflare Workers", "entrypoint": "worker/src/app.ts",
        "interfaces": [
          { "id": "if.xrpc.defineRegulator",   "kind": "XRPC", "method": "POST", "nsid": "com.etzhayyim.apps.openGas.defineRegulator" },
          { "id": "if.xrpc.definePipeSegment", "kind": "XRPC", "method": "POST", "nsid": "com.etzhayyim.apps.openGas.definePipeSegment" },
          { "id": "if.xrpc.getNode",           "kind": "XRPC", "method": "GET",  "nsid": "com.etzhayyim.apps.openGas.getNode" },
          { "id": "if.xrpc.listSegments",      "kind": "XRPC", "method": "GET",  "nsid": "com.etzhayyim.apps.openGas.listSegments" },
          { "id": "if.xrpc.recordReading",     "kind": "XRPC", "method": "POST", "nsid": "com.etzhayyim.apps.openGas.recordReading" },
          { "id": "if.xrpc.reportLeak",        "kind": "XRPC", "method": "POST", "nsid": "com.etzhayyim.apps.openGas.reportLeak" },
          { "id": "if.xrpc.listLeaks",         "kind": "XRPC", "method": "GET",  "nsid": "com.etzhayyim.apps.openGas.listLeaks" },
          { "id": "if.xrpc.recordPressureLog", "kind": "XRPC", "method": "POST", "nsid": "com.etzhayyim.apps.openGas.recordPressureLog" },
          { "id": "if.xrpc.listPressureLogs",  "kind": "XRPC", "method": "GET",  "nsid": "com.etzhayyim.apps.openGas.listPressureLogs" }
        ]
      },
      { "id": "sys.d1", "name": "Cloudflare D1 (SQLite)", "platform": "D1",
        "tables": ["nodes", "segments", "meter_readings", "leaks", "pressure_logs"] },
      { "id": "sys.pds",  "name": "atproto.etzhayyim.com PDS", "platform": "Service binding",
        "interfaces": [{ "id": "if.pds.post", "kind": "wRPC", "method": "app.bsky.feed.post" }] },
      { "id": "sys.auth", "name": "auth.etzhayyim.com", "platform": "Service binding",
        "interfaces": [{ "id": "if.auth.resolveCaller", "kind": "wRPC", "method": "resolveCallerDid" }] }
    ],
    "connections": [
      { "from": "sys.worker", "to": "sys.d1",   "protocol": "D1 binding" },
      { "from": "sys.worker", "to": "sys.pds",  "protocol": "Service binding (wRPC)" },
      { "from": "sys.worker", "to": "sys.auth", "protocol": "Service binding (wRPC)" }
    ]
  },
  "refs": { "viewIds": ["open-gas.OV-1", "open-gas.CV-2"] },
  "version": 1
}
