<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  id="open-gas-define-segment"
                  targetNamespace="https://etzhayyim.com/bpmn/open-gas">
  <bpmn:process id="definePipeSegment" name="Define Pipe Segment" isExecutable="true">
    <bpmn:startEvent id="StartEvent_Init" name="Network design request"/>
    <bpmn:sequenceFlow id="f1" sourceRef="StartEvent_Init" targetRef="Task_CollectSegmentForm"/>
    <bpmn:userTask id="Task_CollectSegmentForm" name="Collect segment form"
                   camunda:formKey="openGas.definePipeSegment.v1"/>
    <bpmn:sequenceFlow id="f2" sourceRef="Task_CollectSegmentForm" targetRef="Task_DefineSegment"/>
    <bpmn:serviceTask id="Task_DefineSegment" name="com.etzhayyim.apps.openGas.definePipeSegment"
                      camunda:topic="com.etzhayyim.apps.openGas.definePipeSegment"/>
    <bpmn:sequenceFlow id="f3" sourceRef="Task_DefineSegment" targetRef="EndEvent_Defined"/>
    <bpmn:endEvent id="EndEvent_Defined" name="Segment defined"/>
  </bpmn:process>
</bpmn:definitions>
