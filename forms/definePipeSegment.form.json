{
  "$schema": "https://etzhayyim.com/schemas/camunda-form/v1",
  "formKey": "openGas.definePipeSegment.v1",
  "name": "Define Pipe Segment",
  "version": 1,
  "lexiconRef": "com.etzhayyim.apps.openGas.definePipeSegment",
  "components": [
    { "key": "regulatorDid", "label": "Regulator DID (origin)", "type": "textfield",
      "validate": { "required": true, "pattern": "^did:[a-z]+:.+" } },
    { "key": "segmentCode", "label": "Segment code", "type": "textfield",
      "validate": { "required": true, "pattern": "^[A-Z0-9-]{2,16}$" } },
    { "key": "diameterMm", "label": "Nominal diameter DN (mm)", "type": "number",
      "validate": { "required": true, "min": 25, "max": 1500 } },
    { "key": "material", "label": "Material", "type": "select",
      "validate": { "required": true },
      "values": [
        { "label": "Steel",          "value": "ST" },
        { "label": "Polyethylene",   "value": "PE" },
        { "label": "Cast iron (legacy)", "value": "CI" }
      ] },
    { "key": "lengthM", "label": "Length (m)", "type": "number",
      "validate": { "required": true, "min": 1 } },
    { "key": "maopKpa", "label": "MAOP (kPa)", "type": "number",
      "validate": { "required": true, "min": 1 } },
    { "key": "servicePoints", "label": "Service points (JSON: [{code,name}])", "type": "textarea",
      "validate": { "required": true } }
  ],
  "variableMappings": {
    "regulatorDid": "regulatorDid", "segmentCode": "segmentCode", "diameterMm": "diameterMm",
    "material": "material", "lengthM": "lengthM", "maopKpa": "maopKpa", "servicePoints": "servicePoints"
  }
}
