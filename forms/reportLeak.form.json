{
  "$schema": "https://etzhayyim.com/schemas/camunda-form/v1",
  "formKey": "openGas.reportLeak.v1",
  "name": "Report Gas Leak",
  "version": 1,
  "lexiconRef": "com.etzhayyim.apps.openGas.reportLeak",
  "components": [
    { "key": "segmentDid", "label": "Pipe segment DID", "type": "textfield",
      "validate": { "required": true, "pattern": "^did:[a-z]+:.+" } },
    { "key": "detectedAt", "label": "Detected at (ISO 8601)", "type": "textfield",
      "validate": { "required": true } },
    { "key": "indoorOrConfined", "label": "Indoor or confined space?", "type": "checkbox", "defaultValue": false },
    { "key": "requiresEvacuation", "label": "Evacuation required?", "type": "checkbox", "defaultValue": false },
    { "key": "hazardToPersons", "label": "Hazard to persons?", "type": "checkbox", "defaultValue": false },
    { "key": "hazardToProperty", "label": "Hazard to property?", "type": "checkbox", "defaultValue": false },
    { "key": "estPpmMethane", "label": "Estimated methane (ppm)", "type": "number",
      "validate": { "min": 0 } },
    { "key": "locationDescription", "label": "Location description", "type": "textfield",
      "validate": { "maxLength": 256 } },
    { "key": "description", "label": "Description", "type": "textarea",
      "validate": { "maxLength": 2048 } }
  ],
  "variableMappings": {
    "segmentDid": "segmentDid", "detectedAt": "detectedAt",
    "indoorOrConfined": "indoorOrConfined", "requiresEvacuation": "requiresEvacuation",
    "hazardToPersons": "hazardToPersons", "hazardToProperty": "hazardToProperty",
    "estPpmMethane": "estPpmMethane", "locationDescription": "locationDescription", "description": "description"
  }
}
